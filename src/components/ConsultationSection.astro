---
import BookingLink from "@/components/BookingLink.astro";
import { siteConfig } from "@/config/site";

interface Props {
  title?: string;
}

const { title = "Get a clear marketing plan for your business." } = Astro.props;
---

<section class="section consultation-section">
  <div class="container consultation-panel">
    <div>
      <p class="eyebrow eyebrow-light">Free consultation</p>
      <h2>{title}</h2>
      <p>{siteConfig.consultationOffer}</p>
      <p class="reassurance">No pressure. No one-size-fits-all plan. Just practical next steps based on your business.</p>
    </div>
    <BookingLink class="button button-light button-large" />
  </div>
</section>
