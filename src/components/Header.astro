---
import BookingLink from "@/components/BookingLink.astro";
import { navigation, siteConfig } from "@/config/site";
import brandLogo from "../../Teal_DS.png";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.brandName} home`}>
      <span class="brand-logo-frame">
        <img
          src={brandLogo.src}
          width={brandLogo.width}
          height={brandLogo.height}
          alt=""
          decoding="async"
        />
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-toggle
    >
      <span class="sr-only">Open navigation menu</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="primary-navigation" class="primary-navigation" aria-label="Primary" data-menu>
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <BookingLink class="button button-primary header-cta" />
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    header?.classList.remove("menu-open");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    header?.classList.toggle("menu-open", !isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
      toggle?.focus();
    }
  });

  const desktopQuery = window.matchMedia("(min-width: 66rem)");
  desktopQuery.addEventListener("change", (event) => event.matches && closeMenu());
</script>
